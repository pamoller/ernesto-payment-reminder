{
  "name": "pamoller/ernesto-payment-reminder-backend",
  "description": "Ernesto Payment Reminder backend",
  "type": "project",
  "require": {
    "php": "^8.3",
    "phpmailer/phpmailer": "^6.10",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "start": "php bin/migrate.php && php -S 127.0.0.1:8080 -t public public/router.php",
    "reminders": "php bin/run-reminders.php",
    "db:bootstrap": "php bin/bootstrap-database.php"
  }
}
